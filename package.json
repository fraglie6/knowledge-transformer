{
  "name": "dsh-knowledge-transform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "index:methods": "node scripts/build-method-index.mjs",
    "validate:methods": "node scripts/validate-method-library.mjs",
    "check": "npm run build && npm run index:methods && npm run validate:methods && node scripts/smoke-cognitive-note.mjs && node scripts/smoke-method-note.mjs && node scripts/smoke-recall-methods.mjs && node scripts/smoke-method-injection.mjs && node scripts/smoke-full-loop.mjs && node scripts/smoke-failure-cases.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-fs": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-tools": "0.1.2-rc.1",
    "@deepseek-ai/schemastery": "3.18.2"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-agent": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-code-runtime": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-invariants": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-llm": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-scope": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-session": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-system-prompt": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-user-approval": "^0.1.2-rc.1",
    "typescript": "^5.9.2"
  }
}
